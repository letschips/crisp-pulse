{
  "name": "crisp-pulse",
  "version": "1.30.0",
  "description": "Your knowledge work, visualized. Local-first activity and contribution analytics with GitHub-style heatmap for Obsidian.",
  "author": "letschips",
  "authorUrl": "https://github.com/letschips",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "hant": "node scripts/gen-hant.cjs",
    "check": "node --check main.js && node --test tests/*.test.cjs tests/memo-workflow.e2e.cjs tests/memo-safety.e2e.cjs tests/memo-asr.e2e.cjs tests/memo-tempo.e2e.cjs tests/memo-annotations.e2e.cjs",
    "test:e2e:license-config": "node tests/config-dir.e2e.cjs",
    "test:e2e:memo": "node --test tests/memo-workflow.e2e.cjs",
    "test:e2e:safety": "node --test tests/memo-safety.e2e.cjs",
    "test:e2e:asr": "node --test tests/memo-asr.e2e.cjs",
    "test:e2e:tempo": "node --test tests/memo-tempo.e2e.cjs",
    "test:e2e:annotations": "node --test tests/memo-annotations.e2e.cjs",
    "test:e2e:celestial": "node tests/celestial-ui.e2e.cjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "crisp",
    "heatmap",
    "analytics",
    "productivity",
    "review"
  ],
  "devDependencies": {
    "opencc-js": "1.0.5"
  }
}
